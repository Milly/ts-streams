{
  "name": "@milly/streams",
  "exports": {
    ".": "./mod.ts",
    "./readable": "./readable/mod.ts",
    "./readable/concat-with": "./readable/concat_with.ts",
    "./readable/defer": "./readable/defer.ts",
    "./readable/empty": "./readable/empty.ts",
    "./readable/error": "./readable/error.ts",
    "./readable/from": "./readable/from.ts",
    "./readable/from-event": "./readable/from_event.ts",
    "./readable/from-message": "./readable/from_message.ts",
    "./readable/interval": "./readable/interval.ts",
    "./readable/merge-with": "./readable/merge_with.ts",
    "./readable/range": "./readable/range.ts",
    "./readable/timer": "./readable/timer.ts",
    "./transform": "./transform/mod.ts",
    "./transform/abort": "./transform/abort.ts",
    "./transform/buffer": "./transform/buffer.ts",
    "./transform/buffer-count": "./transform/buffer_count.ts",
    "./transform/concat-all": "./transform/concat_all.ts",
    "./transform/concat-map": "./transform/concat_map.ts",
    "./transform/count": "./transform/count.ts",
    "./transform/debounce-time": "./transform/debounce_time.ts",
    "./transform/default-with": "./transform/default_with.ts",
    "./transform/delay": "./transform/delay.ts",
    "./transform/every": "./transform/every.ts",
    "./transform/exhaust-all": "./transform/exhaust_all.ts",
    "./transform/exhaust-map": "./transform/exhaust_map.ts",
    "./transform/filter": "./transform/filter.ts",
    "./transform/map": "./transform/map.ts",
    "./transform/max": "./transform/max.ts",
    "./transform/merge-all": "./transform/merge_all.ts",
    "./transform/merge-map": "./transform/merge_map.ts",
    "./transform/min": "./transform/min.ts",
    "./transform/pipe": "./transform/pipe.ts",
    "./transform/reduce": "./transform/reduce.ts",
    "./transform/scan": "./transform/scan.ts",
    "./transform/skip": "./transform/skip.ts",
    "./transform/skip-last": "./transform/skip_last.ts",
    "./transform/skip-while": "./transform/skip_while.ts",
    "./transform/switch-all": "./transform/switch_all.ts",
    "./transform/switch-map": "./transform/switch_map.ts",
    "./transform/take": "./transform/take.ts",
    "./transform/take-last": "./transform/take_last.ts",
    "./transform/take-while": "./transform/take_while.ts",
    "./transform/tap": "./transform/tap.ts",
    "./transform/terminate": "./transform/terminate.ts",
    "./transform/transform": "./transform/transform.ts",
    "./writable": "./writable/mod.ts",
    "./writable/for-each": "./writable/for_each.ts",
    "./writable/post-message": "./writable/post_message.ts",
    "./types": "./types.ts",
    "./util": "./util/mod.ts",
    "./util/pull": "./util/pull.ts",
    "./util/to-array": "./util/to_array.ts",
    "./util/write": "./util/write.ts"
  },
  "imports": {
    "@std/async": "jsr:@std/async@^1.0.1"
  },
  "publish": {
    "exclude": [
      "**/*_bench.ts",
      "**/*_test.ts",
      "**/.*",
      "**/bench.ts",
      "**/test.ts",
      "deno.jsonc",
      "deno.lock",
      "package-lock.json",
      "package.json",
      "scripts/",
      "tests/"
    ]
  }
}
